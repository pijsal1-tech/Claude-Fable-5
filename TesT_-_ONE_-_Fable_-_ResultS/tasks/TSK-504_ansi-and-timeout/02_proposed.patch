+# ── TSK-504: تعقيم ANSI — طبقة نقل، عند موقع ws.send الأوحد ──
+# مزودات CLI/curl (مثل Blackbox) قد تُرجع نصوص خطأ ملوّنة
+# ("\x1b[91m…\x1b[0m") تصل للواجهة خامًا فتظهر كـ "[91m…[0m".
+# التعقيم هنا (وليس في كل مزود) لأن هذا الصنف هو بوابة النقل
+# الوحيدة بالعقد المعماري (T-047) — أي إطار للواجهة يمر من هنا.
+_ANSI_ESCAPE_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
+# الحقول النصية المتجهة للمستخدم فقط — لا نمس بنية الإطار.
+_USER_FACING_TEXT_KEYS = ("text", "message", "error", "summary", "reason")
+
+
+def strip_ansi(value: Any) -> Any:
+    """TSK-504: يزيل تسلسلات ANSI (ألوان/تنسيق تيرمنال) من نص."""
+    if not isinstance(value, str):
+        return value
+    return _ANSI_ESCAPE_RE.sub("", value)
+
+
+def _strip_ansi_frame(frame: dict) -> dict:
+    """تعقيم الحقول النصية المعروفة في إطار واجهة — بدون تغيير البنية."""
+    for key in _USER_FACING_TEXT_KEYS:
+        val = frame.get(key)
+        if isinstance(val, str) and "\x1b[" in val:
+            frame[key] = strip_ansi(val)
+    return frame
+
