المرحلة الثالثة: المزود والبث — provider.stream() والـ Queue
1. نمط Thread + Queue (سطر 678-748)

لدعم إيقاف التوليد أثناء البث دون تجميد الخيط الرئيسي، يُطلق thread منفصل:

python
🧲 Copy
📋 Apply
chunk_queue = queue.Queue()
cancel_event = threading.Event()

def _stream_worker():
    try:
        for chunk in provider.stream(prompt, chat_history[:-1], system_prompt):
            if cancel_event.is_set():
                break
            chunk_queue.put(("chunk", chunk))
        chunk_queue.put(("done", None))
    except Exception as e:
        chunk_queue.put(("error", str(e)))

t = threading.Thread(target=_stream_worker, daemon=True)
t.start()
